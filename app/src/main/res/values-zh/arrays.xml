<!-- UI-side arrays for Simplified Chinese. This file deliberately carries only the arrays
     that belong to the UI ticket: the Discover board, its tile names, and the cooking-time
     words. The domain *vocabulary* lists (grocery keywords, staples, units, protein
     keywords, category/meal aliases, grammar helpers, synonyms, distinctions) are owned by
     a separate ticket and are deliberately absent here, so they fall back to English and
     that work stays unblocked.
     InconsistentArrays compares item counts between locales, which is meaningless for these
     vocabulary-style lists. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="InconsistentArrays">
    <!-- The Discover board. A curated Chinese board is deferred (its sites have not been
         verified for schema.org JSON-LD), so this is the English default board, kept here
         so Chinese households see exactly what the fallback would show. URLs are not
         translated. -->
    <string-array name="discover_sites">
        <item>https://www.allrecipes.com/recipes/</item>
        <item>https://www.bbc.co.uk/food/recipes</item>
        <item>https://www.seriouseats.com/all-recipes-5117985</item>
        <item>https://www.simplyrecipes.com/</item>
        <item>https://www.epicurious.com/recipes-menus</item>
        <item>https://www.delish.com/cooking/recipe-ideas/</item>
        <item>https://www.jamieoliver.com/recipes/</item>
        <item>https://www.budgetbytes.com/category/recipes/</item>
        <item>https://www.tasteofhome.com/recipes/</item>
        <item>https://www.recipetineats.com/recipes/</item>
    </string-array>

    <!-- Site names are brand names and are not translated; the list mirrors the board above. -->
    <string-array name="discover_site_names">
        <item>allrecipes|Allrecipes</item>
        <item>bbcgoodfood|BBC Good Food</item>
        <item>bbc|BBC Food</item>
        <item>seriouseats|Serious Eats</item>
        <item>simplyrecipes|Simply Recipes</item>
        <item>foodnetwork|Food Network</item>
        <item>epicurious|Epicurious</item>
        <item>delish|Delish</item>
        <item>jamieoliver|Jamie Oliver</item>
        <item>budgetbytes|Budget Bytes</item>
        <item>tasteofhome|Taste of Home</item>
        <item>recipetineats|RecipeTin Eats</item>
    </string-array>

    <!-- The words that mark an hour / a minute in a typed or imported cooking time
         ("1小时30分钟"). Read only; what a duration *reads* as is rendered by the platform.
         The universal abbreviations (h, min, …) come from the English list via the union. -->
    <string-array name="duration_hours">
        <item>小时</item>
        <item>个小时</item>
    </string-array>
    <string-array name="duration_minutes">
        <item>分钟</item>
        <item>分</item>
    </string-array>
</resources>
